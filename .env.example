# Database Configuration
# RULE-09 / RULE-10 (PLAT-E30 T-STK3): el runtime corre SIEMPRE bajo el rol de aplicación
# least-privilege stock_app (NOBYPASSRLS) — NUNCA como postgres/superuser, que bypasearía la
# RLS de locations/warehouses/stock_locations/stock_entries/stock_availability (FORCE ROW
# LEVEL SECURITY no aplica a superusers → RLS "activa" pero nunca ejercida). El rol se crea con
# migrations/roles/stock_app.sql (fuera del //go:embed, aplicado out-of-band por un admin). La
# password se fija out-of-band (`ALTER ROLE stock_app PASSWORD '...'`) y NUNCA se commitea; el
# valor de abajo es solo el default de dev local (docker-compose raíz usará
# ${STOCK_DB_PASSWORD:-stock_app123} tras el flip de T-STK6 — hoy el compose aún usa postgres).
DB_HOST=localhost
DB_PORT=5432
DB_USER=stock_app
DB_PASSWORD=stock_app123
DB_NAME=stock_db
DB_SSLMODE=disable

# Server Configuration
PORT=8080
GIN_MODE=release

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=2112

# Logging
LOG_LEVEL=info
